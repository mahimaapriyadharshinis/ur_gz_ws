    <model name="overhead_camera">
      <static>true</static>
      <pose>1.125 0 2.0 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="overhead_camera_sensor" type="camera">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.396</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <topic>/overhead_camera</topic>
        </sensor>
      </link>
    </model>

    <model name="side_camera">
      <static>true</static>
      <pose>1.0 -0.9 0.30 0 0.25 1.5708</pose>
      <link name="camera_link">
        <sensor name="side_camera_sensor" type="camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
          <topic>/side_camera</topic>
        </sensor>
      </link>
    </model>

    <model name="overhead_depth_camera">
      <static>true</static>
      <pose>1.125 0 2.0 0 1.5708 0</pose>
      <link name="depth_camera_link">
        <sensor name="overhead_depth_camera_sensor" type="rgbd_camera">
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.396</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <topic>/overhead_rgbd</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
